{
  "name": "rayo-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/admin",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:services": "node --env-file-if-exists=.env scripts/dev.mjs --services",
    "build": "npm run build -w apps/admin",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "service": "node --env-file-if-exists=.env services/run.mjs",
    "format": "prettier --write apps services packages tests scripts docs README.md package.json compose.yaml",
    "setup:local": "node scripts/local-database.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/bootstrap-admin.mjs",
    "test:production": "node scripts/test-production.mjs",
    "dev:demo": "RAYO_MODE=demo node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:mail": "mailpit --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025 --disable-version-check --database .local/mailpit.db --quiet"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
