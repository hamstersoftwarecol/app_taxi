RAYO_MODE=production
NODE_ENV=production
# Nunca subas secretos al repositorio. Genera INTERNAL_KEY y METRICS_TOKEN aleatorios.
DATABASE_URL=postgresql://rayo:REPLACE_PASSWORD@postgres:5432/rayo
INTERNAL_KEY=
METRICS_TOKEN=
PUBLIC_APP_URL=https://REPLACE_DOMAIN
CORS_ORIGINS=https://REPLACE_DOMAIN
TRUST_PROXY_HOPS=1
PG_POOL_SIZE=10
LOG_REQUESTS=true
MAPBOX_TOKEN=
MAPBOX_PUBLIC_TOKEN=
# Define las reglas autorizadas por tu operación. Sin ellas no se cotiza.
# FARE_RULES_JSON={"mini":{"base":4000,"perKm":1500,"perMinute":250,"minimum":7000},"sedan":{"base":5000,"perKm":2000,"perMinute":300,"minimum":10000},"suv":{"base":7000,"perKm":2500,"perMinute":350,"minimum":14000}}
FARE_RULES_JSON=
MAX_TRIP_METERS=150000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
